---
layout: base.njk
---

{% include "intro.njk" %}

<p class="home-statement" id="about">I build software and study how machine learning represents physical systems.</p>

<section class="home-selection" id="work">
  <h2>Work</h2>
  <ul class="plain-index">
  {%- for project in making %}
    {%- if project.home %}
    <li>{% if project.href %}<a href="{{ project.href }}">{{ project.title }}</a>{% else %}{{ project.title }}{% endif %}</li>
    {%- endif %}
  {%- endfor %}
    <li><a href="/notes/deconstructing-algorithms/">Deconstructing Algorithms: a thesis studio on algorithmic literacy</a></li>
  {%- for pub in publications %}
    {%- if not pub.hideFromHome %}
    <li><a href="https://doi.org/{{ pub.doi }}" title="View at {{ pub.publisher }}" aria-label="{{ pub.shortTitle or pub.title }} ({{ pub.publisher }}, external website)">{{ pub.shortTitle or pub.title }}&nbsp;<span class="external-link-marker" aria-hidden="true">({{ pub.publisher }})</span></a></li>
    {%- endif %}
  {%- endfor %}
  </ul>
</section>

<p class="home-links" id="contact">
  <a href="/cv/">CV</a>
  <a href="https://mathscapes.xyz/">Mathscapes</a>
  <a href="https://barelydiscernible.bearblog.dev/">Blog</a>
  <a href="mailto:{{ site.author.email }}">{{ site.author.email }}</a>
</p>
