---
layout: base.njk
---
<article class="note-raw">
  <header>
    <p class="note-id">{{ id }}</p>
    <h1>{{ title }}</h1>
    <p class="note-date">{{ date | shortDate }}</p>
  </header>
  <div class="note-body">
    {{ content | safe }}
  </div>
  {% if noteBacklinks and noteBacklinks.length > 0 %}
  <section class="note-backlinks">
    <h2>Referenced in</h2>
    <ul>
      {% for bl in noteBacklinks %}
      <li><a href="/{{ bl.id }}/">{{ bl.id }} — {{ bl.title }}</a></li>
      {% endfor %}
    </ul>
  </section>
  {% endif %}
</article>
