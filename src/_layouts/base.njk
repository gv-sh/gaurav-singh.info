<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{% if page.url == "/" %}{{ site.title }}{% elif title %}{{ title }} | {{ site.title }}{% else %}{{ site.title }}{% endif %}</title>
    <meta name="description" content="{% if description %}{{ description }}{% else %}{{ site.description }}{% endif %}">
    <link rel="canonical" href="{{ site.url }}{{ page.url }}">
    {%- if noarchive %}
    <!-- indexable, but no cached/archived copies -->
    <meta name="robots" content="noarchive">
    {%- endif %}

    <!-- Favicon -->
    <link rel="icon" type="image/svg+xml" href="/assets/favicon.svg">

    <!-- CSS -->
    <link rel="preload" href="/assets/fonts/InterVariable.woff2" as="font" type="font/woff2" crossorigin>
    <link rel="stylesheet" href="/assets/css/main.css?v=20260924-consistent-cv">
    <!-- SEO Meta Tags -->
    <meta property="og:title" content="{% if page.url == "/" %}{{ site.title }}{% elif title %}{{ title }}{% else %}{{ site.title }}{% endif %}">
    <meta property="og:description" content="{% if description %}{{ description }}{% else %}{{ site.description }}{% endif %}">
    <meta property="og:type" content="{% if kind == "project" %}article{% else %}website{% endif %}">
    <meta property="og:site_name" content="{{ site.title }}">
    <meta property="og:url" content="{{ site.url }}{{ page.url }}">
    {% if image %}<meta property="og:image" content="{{ site.url }}{{ image }}">{% endif %}
    {% if kind == "project" %}<meta property="article:published_time" content="{{ date | isoDate }}">{% endif %}
    <meta name="twitter:card" content="{% if image %}summary_large_image{% else %}summary{% endif %}">
    <meta name="twitter:title" content="{% if page.url == "/" %}{{ site.title }}{% elif title %}{{ title }}{% else %}{{ site.title }}{% endif %}">
    <meta name="twitter:description" content="{% if description %}{{ description }}{% else %}{{ site.description }}{% endif %}">
    {% if image %}<meta name="twitter:image" content="{{ site.url }}{{ image }}">{% endif %}

    <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@graph": [
        {
          "@type": "Person",
          "@id": "{{ site.url }}/#person",
          "name": {{ site.author.name | json | safe }},
          "url": "{{ site.url }}/",
          "email": "mailto:{{ site.author.email }}",
          "jobTitle": {{ site.author.jobTitle | json | safe }},
          "sameAs": {{ site.author.sameAs | json | safe }}
        },
        {
          "@type": "WebSite",
          "@id": "{{ site.url }}/#website",
          "url": "{{ site.url }}/",
          "name": {{ site.title | json | safe }},
          "description": {{ site.description | json | safe }},
          "author": { "@id": "{{ site.url }}/#person" }
        },
        {
          "@type": {% if isCv %}["WebPage", "ProfilePage"]{% else %}"WebPage"{% endif %},
          "@id": "{{ site.url }}{{ page.url }}#webpage",
          "url": "{{ site.url }}{{ page.url }}",
          "name": {{ title | default(site.title) | json | safe }},
          "description": {{ description | default(site.description) | json | safe }},
          "isPartOf": { "@id": "{{ site.url }}/#website" },
          "about": { "@id": "{{ site.url }}/#person" },
          "author": { "@id": "{{ site.url }}/#person" }{% if isCv %},
          "mainEntity": { "@id": "{{ site.url }}/#person" }{% endif %}
        }{% if kind == "project" %},
        {
          "@type": "CreativeWork",
          "@id": "{{ site.url }}{{ page.url }}#work",
          "name": {{ title | json | safe }},
          "description": {{ description | default(site.description) | json | safe }},
          "url": "{{ site.url }}{{ page.url }}",
          "datePublished": "{{ date | isoDate }}",
          {% if image %}"image": "{{ site.url }}{{ image }}",{% endif %}
          "creator": { "@id": "{{ site.url }}/#person" },
          "mainEntityOfPage": { "@id": "{{ site.url }}{{ page.url }}#webpage" }
        }{% endif %}
      ]
    }
    </script>

    <!-- Google Analytics -->
    <script async src="https://www.googletagmanager.com/gtag/js?id=G-KEN47XT3N8"></script>
    <script>
        window.dataLayer = window.dataLayer || [];
        function gtag(){dataLayer.push(arguments);}
        gtag('js', new Date());
        gtag('config', 'G-KEN47XT3N8');
    </script>

</head>
<body{% if bodyClass %} class="{{ bodyClass }}"{% endif %}>
    <main>
        {{ content | safe }}
    </main>
    {% if not hideFooter %}{% include "footer.njk" %}{% endif %}
</body>
</html>
