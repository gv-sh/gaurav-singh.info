---
layout: base.njk
title: Making
description: Things Gaurav Singh has made
---
{% include "intro.njk" %}
{% include "nav.njk" %}

<h2>Making</h2>
<ul class="entries">
{%- for m in collections.made %}
  <li class="entry">
    <span class="entry-key">{{ m.year }}</span>
    <div class="entry-body">
      <span class="entry-title">{%- if m.href %}<a href="{{ m.href }}">{{ m.title }}</a>{% else %}{{ m.title }}{% endif %}</span>
      {%- if m.note %}<p class="entry-note">{{ m.note }}</p>{% endif %}
      {%- if m.blurb %}<p class="entry-blurb">{{ m.blurb }}</p>{% endif %}
      {%- if m.links and m.links.length %}<p class="entry-note">Notes: {% for l in m.links %}<a href="{{ l.href }}">{{ l.label }}</a>{% if not loop.last %} · {% endif %}{% endfor %}</p>{% endif %}
    </div>
  </li>
{%- endfor %}
</ul>
